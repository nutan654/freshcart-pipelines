# Copy to .env and fill locally. Never commit .env.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/%2F

# Set these only when running Snowflake ELT / bonus integration.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=FRESHCART_WH
FRESHCART_LANDING_DIR=./freshcart_landing
